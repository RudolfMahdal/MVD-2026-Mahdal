import numpy as np
import time

start = time.time()
rng = np.random.default_rng()

A = rng.random((50000, 50000), dtype=np.float64)

print(f"Matice vygenerována za {time.time() - start:.2f} s.")
print(f"Velikost matice v paměti: {A.nbytes / 1e9:.2f} GB")

start = time.time()
mean_val = A.mean()
print(f"Průměr: {mean_val} (výpočet trval {time.time() - start:.2f} s)")

start = time.time()
std_val = A.std()
print(f"Směrodatná odchylka: {std_val} (výpočet trval {time.time() - start:.2f} s)")
